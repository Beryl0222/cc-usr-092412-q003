{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "医保服务目录映射台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CATALOG_DRAFTED",
        "MAPPING_PROPOSED",
        "MAPPING_APPROVED",
        "VERSION_ACTIVATED",
        "CLAIM_ADJUSTED",
        "DIMENSION_VERSION_REGISTERED",
        "MAPPING_CANDIDATE_PROPOSED",
        "MAPPING_CANDIDATE_SIGNED",
        "MAPPING_DECISION_EFFECTIVE",
        "MAPPING_DECISION_CLOSED",
        "MAPPING_DECISION_DEACTIVATED",
        "MAPPING_DISPUTE_RAISED",
        "MAPPING_DISPUTE_RESOLVED",
        "CLAIM_SETTLED",
        "CLAIM_PENDING",
        "DIFFERENCE_RAISED",
        "DIFFERENCE_REVIEWED",
        "BATCH_IMPORT_COMPLETED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "national_item",
        "provincial_item",
        "mapping_decision",
        "claim_line",
        "catalog_dimension",
        "mapping_candidate",
        "settlement_batch"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
